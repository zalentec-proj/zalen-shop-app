# ============================================================
# Brasil Drones — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local com valores reais.
# ============================================================

# --- Supabase ---
# URL do projeto Supabase (pública — pode aparecer no frontend)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/publishable do Supabase (pública — pode aparecer no frontend)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-aqui

# Chave service_role do Supabase (SECRETA — apenas no servidor)
# NUNCA expor no frontend ou commitar
SUPABASE_SECRET_KEY=sua-service-role-key-aqui

# --- App ---
APP_URL=http://localhost:3000

# --- Bling (OAuth 2.0) ---
# NUNCA expor no frontend
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=${APP_URL}/integrations/bling/callback

# --- Mercado Pago ---
# NUNCA expor no frontend
MERCADO_PAGO_ACCESS_TOKEN=

# --- Melhor Envio ---
# NUNCA expor no frontend
MELHOR_ENVIO_TOKEN=

# --- Gemini AI (opcional) ---
GEMINI_API_KEY=
