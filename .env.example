# ============================================================
# Zalen Shop App — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local com valores reais.
# ============================================================

# --- Supabase ---
# Local: copie o valor "API URL" exibido por `npx supabase status`.
# Exemplo local comum: http://127.0.0.1:54321
# URL pública do Supabase — pode aparecer no frontend.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Local: copie o valor "anon key" ou "publishable key" exibido pelo CLI.
# Chave anon/publishable do Supabase — pode aparecer no frontend.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-aqui

# Local: copie o valor "service_role key" exibido pelo CLI.
# Chave service_role do Supabase — SECRETA, apenas no servidor.
# NUNCA expor no frontend, logar ou commitar.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Compatibilidade com versões anteriores. Preferir SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sua-service-role-key-aqui

# --- App ---
# Produção: app principal Zalen Shop.
APP_URL=https://app.zalenshop.com.br
# Desenvolvimento local:
# APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=zalenshop.com.br
# Produção: compartilha somente a sessão administrativa entre hosts Zalen.
AUTH_COOKIE_DOMAIN=.zalenshop.com.br

# --- Domínios próprios (Vercel, somente servidor) ---
# Token com o menor escopo capaz de gerenciar domínios do projeto indicado.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Publicar inicialmente desligado; habilitar por loja no piloto.
DOMAIN_SELF_SERVICE_ENABLED=false
# IDs ou slugs separados por vírgula. Vazio libera todas quando a flag estiver true.
DOMAIN_SELF_SERVICE_STORE_ALLOWLIST=brasil-drones

# --- E-mails transacionais (Resend) ---
# NUNCA expor no frontend.
RESEND_API_KEY=
# Secret de assinatura entregue pelo webhook do Resend. Apenas servidor.
RESEND_WEBHOOK_SECRET=
# Use um remetente de dominio verificado no Resend para envios reais.
EMAIL_DEFAULT_FROM="Zalen Shop <no-reply@seudominio.com.br>"
EMAIL_DEFAULT_REPLY_TO=atendimento@seudominio.com.br

# --- Bling (OAuth 2.0) ---
# NUNCA expor no frontend
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Produção: callback cadastrado no app Bling.
BLING_REDIRECT_URI=https://app.zalenshop.com.br/api/integrations/bling/callback
# Desenvolvimento local:
# BLING_REDIRECT_URI=http://localhost:3000/api/integrations/bling/callback
BLING_SCOPES=
BLING_ENV=production

# --- Bling privado Brasil Drones (scripts operacionais locais) ---
# Estas variáveis são separadas do conector global da Zalen Shop.
# Callback cadastrado no app privado: http://localhost:8787/bling/callback
BLING_CUSTOMER_CLIENT_ID=
BLING_CUSTOMER_CLIENT_SECRET=
BLING_CALLBACK_PORT=8787
# Necessário somente se houver mais de um depósito ativo que considere saldo.
BLING_CUSTOMER_DEPOSITO_ID=
# Gate explícito para a carga real do novo catálogo. Manter false por padrão.
BRASIL_DRONES_IMPORT_APPROVED=false
# Gate separado para atualizar GTIN, custo e conferir o estoque do catálogo existente.
BRASIL_DRONES_DATA_UPDATE_APPROVED=false
BRASIL_DRONES_COST_UPDATE_APPROVED=false
BLING_CUSTOMER_SUPPLIER_ID=

# Chave secreta server-side para criptografar credenciais de integrações.
# Use um valor forte e diferente por ambiente. NUNCA use NEXT_PUBLIC_.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Temporário durante rotação coordenada; remover após recriptografar e validar.
INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Mercado Pago ---
# Use "test" para credenciais de teste e "production" para credenciais reais.
MERCADO_PAGO_ENV=test
# NUNCA expor no frontend
MERCADO_PAGO_ACCESS_TOKEN=
# Reservada para Checkout Transparente/Bricks. Não usar em secret server-side.
MERCADO_PAGO_PUBLIC_KEY=
# Secret gerado em Webhooks > Configurar notificações no Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=
# Aplicação OAuth da Zalen. Client Secret nunca sai do servidor.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=https://app.zalenshop.com.br/api/integrations/mercado-pago/callback
# Secrets de assinatura exclusivos de cada ambiente.
MERCADO_PAGO_WEBHOOK_SECRET_TEST=
MERCADO_PAGO_WEBHOOK_SECRET_PRODUCTION=
# Sandbox: e-mail sintético que não pode pertencer ao vendedor ou a uma conta de teste Mercado Pago.
MERCADO_PAGO_TEST_PAYER_EMAIL=checkout-test@exemplo-invalido.test

# --- Segurança e observabilidade ---
# Segredo independente para derivar hashes irreversíveis dos buckets de rate limit.
RATE_LIMIT_HASH_SECRET=
# Autorização para jobs internos/cron. Não expor no navegador.
CRON_SECRET=
INTERNAL_JOB_SECRET=
# Observabilidade server-side. O DSN não contém PII e o SDK remove usuário/extras.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Melhor Envio ---
# NUNCA expor no frontend
MELHOR_ENVIO_TOKEN=

# --- Gemini AI (opcional) ---
GEMINI_API_KEY=
